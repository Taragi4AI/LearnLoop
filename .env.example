# Copy this file to `.env` and paste your real key.
# Get a key at https://www.boson.ai/workspace/api-key  (format: bai-xxxx)
BOSON_API_KEY=bai-xxxx

# Optional overrides
PORT=3000
BOSON_API_BASE=https://api.boson.ai/v1

# Optional: realtime lip-synced Higgs avatar (use credentials from one LiveKit Cloud project)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret
