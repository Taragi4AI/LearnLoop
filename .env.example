# Copy this file to `.env` and paste your real key.
# Get a key at https://www.boson.ai/workspace/api-key  (format: bai-xxxx)
BOSON_API_KEY=bai-xxxx

# Required only for live Higgs Avatar video (free LiveKit Cloud project).
# Create these in LiveKit Cloud -> Settings -> Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=replace-with-livekit-secret

# Optional overrides
PORT=3000
BOSON_API_BASE=https://api.boson.ai/v1
